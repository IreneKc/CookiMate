@page
@model MyRecipesModel
@{
    ViewData["Title"] = "My Recipes";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .myrecipes-container {
            max-width: 1200px;
            margin: 40px auto 60px auto;
            padding: 0 20px;
        }

        .myrecipes-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .myrecipes-title-wrap h1 {
            font-size: 30px;
            font-weight: 700;
            color: #2f5d2f;
            margin-bottom: 6px;
        }

        .myrecipes-title-wrap p {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.7;
            max-width: 700px;
        }

        .upload-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 20px;
            border-radius: 14px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            color: #ffffff;
            background: linear-gradient(135deg, #4e9f3d, #7bc043);
            box-shadow: 0 10px 22px rgba(78, 159, 61, 0.20);
            transition: 0.22s ease;
        }

        .upload-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 26px rgba(78, 159, 61, 0.28);
            color: #ffffff;
            text-decoration: none;
        }

        .summary-bar {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 26px;
        }

        .summary-card {
            background: #ffffff;
            border-radius: 18px;
            padding: 18px 20px;
            border: 1px solid #eef2e8;
            box-shadow: 0 10px 28px rgba(0, 0, 0, 0.05);
        }

        .summary-label {
            font-size: 13px;
            font-weight: 600;
            color: #6b7280;
            margin-bottom: 8px;
        }

        .summary-value {
            font-size: 26px;
            font-weight: 700;
            color: #2f5d2f;
        }

        .recipes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 22px;
        }

        .recipe-card {
            background: #ffffff;
            border-radius: 22px;
            overflow: hidden;
            border: 1px solid #eef2e8;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
            transition: transform 0.22s ease, box-shadow 0.22s ease;
        }

        .recipe-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 22px 42px rgba(0, 0, 0, 0.09);
        }

        .recipe-image-wrap {
            position: relative;
            width: 100%;
            height: 220px;
            background: linear-gradient(135deg, #f7fbf4, #eef8e8);
            overflow: hidden;
        }

        .recipe-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .status-badge {
            position: absolute;
            top: 14px;
            right: 14px;
            padding: 7px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            text-transform: capitalize;
            backdrop-filter: blur(8px);
        }

        .status-approved {
            background: rgba(220, 252, 231, 0.95);
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .status-pending {
            background: rgba(254, 249, 195, 0.96);
            color: #854d0e;
            border: 1px solid #fde68a;
        }

        .status-rejected {
            background: rgba(254, 226, 226, 0.96);
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .status-default {
            background: rgba(243, 244, 246, 0.96);
            color: #374151;
            border: 1px solid #d1d5db;
        }

        .recipe-body {
            padding: 20px;
        }

        .recipe-title {
            font-size: 20px;
            font-weight: 700;
            color: #2f5d2f;
            margin-bottom: 14px;
            line-height: 1.4;
            word-break: break-word;
        }

        .recipe-meta-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .meta-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
            border-bottom: 1px solid #f3f4f6;
            padding-bottom: 10px;
        }

        .meta-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .meta-label {
            font-size: 13px;
            font-weight: 600;
            color: #6b7280;
            min-width: 90px;
        }

        .meta-value {
            font-size: 13px;
            color: #374151;
            text-align: right;
            word-break: break-word;
        }

        .meta-link {
            color: #4e9f3d;
            text-decoration: none;
            font-weight: 500;
        }

        .meta-link:hover {
            text-decoration: underline;
        }

        .empty-state {
            background: #ffffff;
            border-radius: 24px;
            padding: 50px 28px;
            text-align: center;
            border: 1px solid #eef2e8;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
        }

        .empty-icon {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            color: #4e9f3d;
            font-size: 28px;
            font-weight: 700;
        }

        .empty-state h3 {
            font-size: 24px;
            font-weight: 700;
            color: #2f5d2f;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.7;
            max-width: 500px;
            margin: 0 auto 22px;
        }

        @@media (max-width: 900px) {
            .summary-bar {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 640px) {
            .myrecipes-header {
                align-items: stretch;
            }

            .upload-btn {
                width: 100%;
            }

            .recipe-image-wrap {
                height: 200px;
            }

            .recipe-title {
                font-size: 18px;
            }

            .meta-row {
                flex-direction: column;
                align-items: flex-start;
            }

            .meta-value {
                text-align: left;
            }
        }
        .summary-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .summary-card {
            cursor: pointer;
            transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
        }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
        }

        .summary-card.active-filter {
            border: 1.5px solid #7bc043;
            box-shadow: 0 14px 30px rgba(78, 159, 61, 0.12);
        }
        .recipe-actions {
            display: flex;
            gap: 12px;
            margin-top: 18px;
            width: 100%;
        }

        .recipe-actions > * {
            flex: 1;
        }

        .recipe-actions form {
           margin: 0;
        }

        .edit-btn,
        .delete-btn {
            width: 100%;
            border: none;
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: 0.22s ease;
            display: inline-flex;
           align-items: center;
           justify-content: center;
        }

        .edit-btn {
           background: linear-gradient(135deg, #4e9f3d, #7bc043);
           color: white;
           box-shadow: 0 10px 20px rgba(78, 159, 61, 0.20);
        }

        .edit-btn:hover {
         color: white;
         text-decoration: none;
         opacity: 0.92;
         transform: translateY(-1px);
        }

        .delete-btn {
         background: linear-gradient(135deg, #ef4444, #f87171);
         color: white;
         box-shadow: 0 10px 20px rgba(239, 68, 68, 0.18);
        }

        .delete-btn:hover {
           opacity: 0.92;
          transform: translateY(-1px);
        }
        .hidden {
            display: none;
        }

        .delete-confirm-box {
            margin-top: 14px;
         padding: 14px;
          border-radius: 14px;
          background: #fff1f2;
          border: 1px solid #fecaca;
          animation: fadeIn 0.2s ease;
        }

        .delete-confirm-box p {
           font-size: 14px;
           color: #991b1b;
           margin-bottom: 10px;
        }

        .confirm-actions {
           display: flex;
           gap: 10px;
           flex-wrap: wrap;
        }

        .confirm-delete-btn {
          flex: 1;
          border: none;
          border-radius: 12px;
          padding: 10px;
          font-weight: 600;
          cursor: pointer;
          background: linear-gradient(135deg, #ef4444, #f87171);
          color: white;
        }

        .cancel-delete-btn {
            flex: 1;
            border: 1px solid #fecaca;
            border-radius: 12px;
            padding: 10px;
            font-weight: 600;
            cursor: pointer;
            background: white;
            color: #991b1b;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-4px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

@functions {
    public string GetStatusClass(string? status)
    {
        return (status ?? "").ToLower() switch
        {
            "approved" => "status-approved",
            "pending" => "status-pending",
            "rejected" => "status-rejected",
            _ => "status-default"
        };
    }
}

<div class="myrecipes-container">
    <div class="myrecipes-header">
        <div class="myrecipes-title-wrap">
            <h1>My Recipes</h1>
            <p>
                View and track the recipes you have uploaded. You can monitor each recipe’s image, status,
                creation date, and latest update in one place.
            </p>
        </div>

        <a href="/Upload" class="upload-btn">
            <span>+</span>
            <span>Upload Recipe</span>
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="margin-bottom:16px; padding:12px 14px; border-radius:14px; background:#fef2f2; color:#dc2626; border:1px solid #fecaca;">
            @Model.ErrorMessage
        </div>
    }

    <div class="summary-bar">
        <a href="/MyRecipes?status=all" class="summary-link">
            <div class="summary-card @(Model.CurrentStatusFilter == "all" ? "active-filter" : "")">
                <div class="summary-label">Total Uploaded Recipes</div>
                <div class="summary-value">@Model.TotalRecipesCount</div>
            </div>
        </a>

        <a href="/MyRecipes?status=pending" class="summary-link">
            <div class="summary-card @(Model.CurrentStatusFilter == "pending" ? "active-filter" : "")">
                <div class="summary-label">Pending Recipes</div>
                <div class="summary-value">@Model.PendingRecipesCount</div>
            </div>
        </a>

        <a href="/MyRecipes?status=approved" class="summary-link">
            <div class="summary-card @(Model.CurrentStatusFilter == "approved" ? "active-filter" : "")">
                <div class="summary-label">Approved Recipes</div>
                <div class="summary-value">@Model.ApprovedRecipesCount</div>
            </div>
        </a>

        <a href="/MyRecipes?status=rejected" class="summary-link">
            <div class="summary-card @(Model.CurrentStatusFilter == "rejected" ? "active-filter" : "")">
                <div class="summary-label">Rejected Recipes</div>
                <div class="summary-value">@Model.RejectedRecipesCount</div>
            </div>
        </a>
    </div>

    @if (Model.Recipes == null || !Model.Recipes.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🍽</div>
            <h3>No recipes uploaded yet</h3>
            <p>
                Start sharing your dishes with CookiMate. Upload your first recipe and it will appear here.
            </p>
            <a href="/Upload" class="upload-btn">
                <span>+</span>
                <span>Upload Your First Recipe</span>
            </a>
        </div>
    }
    else
    {
        <div class="recipes-grid">
            @foreach (var recipe in Model.Recipes)
            {
                var imagePath = string.IsNullOrWhiteSpace(recipe.ImageUrl)
                    ? "/images/recipes/default-food.jpg"
                    : recipe.ImageUrl;

                <div class="recipe-card">
                    <div class="recipe-image-wrap">
                        <img src="@imagePath" alt="@recipe.Title" class="recipe-image" />
                        <span class="status-badge @GetStatusClass(recipe.Status)">
                            @recipe.Status
                        </span>
                    </div>

                    <div class="recipe-body">
                        <div class="recipe-title">@recipe.Title</div>

                        <div class="recipe-meta-list">
                            <div class="meta-row">
                                <div class="meta-label">Image URL</div>
                                <div class="meta-value">
                                    <a href="@imagePath" target="_blank" class="meta-link">@imagePath</a>
                                </div>
                            </div>

                            <div class="meta-row">
                                <div class="meta-label">Status</div>
                                <div class="meta-value">@recipe.Status</div>
                            </div>

                            <div class="meta-row">
                                <div class="meta-label">Created At</div>
                                <div class="meta-value">@recipe.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>

                            <div class="meta-row">
                                <div class="meta-label">Updated At</div>
                                <div class="meta-value">@recipe.UpdatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>
                        </div>
                        <div class="recipe-actions">
                            <a href="/EditRecipe?id=@recipe.RecipeId" class="edit-btn">Edit</a>

                            <button type="button" class="delete-btn" onclick="toggleDeleteConfirm(@recipe.RecipeId)">
                                Delete
                            </button>
                        </div>

                        <div id="deleteConfirm-@recipe.RecipeId" class="delete-confirm-box hidden">
                            <p>Are you sure you want to delete this recipe?</p>

                            <div class="confirm-actions">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@recipe.RecipeId">
                                    <button type="submit" class="confirm-delete-btn">Yes, Delete</button>
                                </form>

                                <button type="button" class="cancel-delete-btn" onclick="toggleDeleteConfirm(@recipe.RecipeId)">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleDeleteConfirm(id) {
            const box = document.getElementById(`deleteConfirm-${id}`);
            if (box) {
                box.classList.toggle("hidden");
            }
        }
    </script>
}