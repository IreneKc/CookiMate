@page
@model CookiMateWeb.Pages.ProfileModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .profile-page {
            background: radial-gradient(circle at top left, rgba(123, 192, 67, 0.10), transparent 28%), radial-gradient(circle at top right, rgba(78, 159, 61, 0.08), transparent 24%), linear-gradient(to bottom, #f8fcf6, #ffffff 260px);
            min-height: 100vh;
        }

        .profile-container {
            max-width: 720px;
            margin: 0 auto;
            padding: 34px 20px 70px;
        }

        .hero-card {
            background: linear-gradient(135deg, #ffffff, #f6fbf2);
            border: 1px solid #eef2e8;
            border-radius: 28px;
            padding: 30px 30px 8px;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.06);
            margin-bottom: 26px;
        }

        .hero-title {
            font-size: 30px;
            font-weight: 800;
            color: #2f5d2f;
            margin-bottom: 6px;
        }

        .hero-subtitle {
            color: #6b7280;
            font-size: 14.5px;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .form-card {
            background: #ffffff;
            border: 1px solid #eef2e8;
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.05);
        }

        .field-group {
            margin-bottom: 20px;
        }

        .field-label {
            display: block;
            font-size: 13.5px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 6px;
        }

        .field-hint {
            font-size: 12.5px;
            color: #9ca3af;
            margin-top: 5px;
        }

        .field-control {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 12px;
            padding: 11px 14px;
            font-size: 14.5px;
            outline: none;
            transition: border-color 0.15s ease;
        }

            .field-control:focus {
                border-color: #7bc043;
            }

        select.field-control {
            background: #ffffff;
        }

        .save-btn {
            width: 100%;
            border: none;
            border-radius: 999px;
            padding: 13px 20px;
            font-size: 15px;
            font-weight: 700;
            color: #ffffff;
            background: linear-gradient(135deg, #4e9f3d, #7bc043);
            cursor: pointer;
            transition: opacity 0.15s ease, transform 0.15s ease;
        }

            .save-btn:hover {
                opacity: 0.92;
                transform: translateY(-1px);
            }

        .alert-success {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .alert-error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .allergen-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 8px;
        }

        .allergen-option {
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid #d1d5db;
            border-radius: 12px;
            padding: 9px 12px;
            font-size: 13.5px;
            color: #374151;
            cursor: pointer;
            transition: border-color 0.15s ease, background 0.15s ease;
        }

            .allergen-option:has(input:checked) {
                border-color: #7bc043;
                background: #f0fdf4;
                color: #2f5d2f;
                font-weight: 600;
            }

            .allergen-option input {
                accent-color: #4e9f3d;
                width: 15px;
                height: 15px;
            }
    </style>
}

<div class="profile-page">
    <div class="profile-container">
        <div class="hero-card">
            <div class="hero-title">My Profile</div>
            <div class="hero-subtitle">
                Tell CookiMate about your diet, allergies, and dislikes. We'll save these
                to your account so you don't have to repeat yourself every time you search.
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert-success">@Model.SuccessMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        <div class="form-card">
            <form method="post">
                <div class="field-group">
                    <label asp-for="Input.Diet" class="field-label">Dietary Preference</label>
                    <select asp-for="Input.Diet" class="field-control">
                        <option value="">No preference</option>
                        <option value="vegetarian">Vegetarian</option>
                        <option value="vegan">Vegan</option>
                        <option value="halal">Halal</option>
                        <option value="low-carb">Low-Carb</option>
                    </select>
                    <div class="field-hint">Saved for reference only right now — it doesn't yet auto-filter Search or Recommendations.</div>
                </div>

                <div class="field-group">
                    <label class="field-label">Allergies</label>
                    <div class="allergen-grid">
                        @foreach (var opt in Model.AllergenOptions)
                        {
                            <label class="allergen-option">
                                <input type="checkbox"
                                       name="Input.SelectedAllergies"
                                       value="@opt.Value"
                                       checked="@Model.Input.SelectedAllergies.Contains(opt.Value)" />
                                @opt.Label
                            </label>
                        }
                    </div>
                    <div class="field-hint">Select all that apply — used later to flag matching recipes automatically.</div>
                </div>

                <div class="field-group">
                    <label asp-for="Input.Dislikes" class="field-label">Dislikes</label>
                    <input asp-for="Input.Dislikes" class="field-control" placeholder="e.g. cilantro, liver, blue cheese" maxlength="500" />
                    <div class="field-hint">Separate multiple items with commas.</div>
                </div>

                <button type="submit" class="save-btn">Save Profile</button>
            </form>
        </div>
    </div>
</div>
