    <div id="cookimateChatWidget">
        <button id="cookimateChatToggle" type="button" class="cookimate-chat-fab" aria-label="Open CookiMate AI Assistant">
            <i class="fa-solid fa-comment-dots"></i>
        </button>

        <div id="cookimateChatPanel" class="cookimate-chat-panel cookimate-chat-hidden">
            <div class="cookimate-chat-header">
                <div class="cookimate-chat-title">CookiMate AI Assistant</div>
                <button id="cookimateChatClose" type="button" class="cookimate-chat-close" aria-label="Close chat">×</button>
            </div>

            <div id="cookimateChatBody" class="cookimate-chat-body">
                <div class="cookimate-msg cookimate-msg-bot">
                    Hi! I'm CookiMate AI. Tell me what you're after — e.g. "vegetarian dinner under 30 minutes" or "quick lunch ideas" — and I'll find matching recipes.
                </div>
            </div>

            <div class="cookimate-chat-footer">
                <div class="cookimate-chat-inputrow">
                    <input id="cookimateChatInput" type="text" class="cookimate-chat-input"
                           placeholder="Ask for a recipe…" autocomplete="off" maxlength="200" />
                    <button id="cookimateChatSend" type="button" class="cookimate-chat-send" aria-label="Send message">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("cookimateChatToggle");
        const closeBtn = document.getElementById("cookimateChatClose");
        const panel = document.getElementById("cookimateChatPanel");
        const widget = document.getElementById("cookimateChatWidget");
        const body = document.getElementById("cookimateChatBody");
        const input = document.getElementById("cookimateChatInput");
        const sendBtn = document.getElementById("cookimateChatSend");

        if (toggleBtn && panel) {
        toggleBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        panel.classList.toggle("cookimate-chat-hidden");
        if (!panel.classList.contains("cookimate-chat-hidden") && input) {
        input.focus();
        }
        });
        }

        if (closeBtn && panel) {
        closeBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        panel.classList.add("cookimate-chat-hidden");
        });
        }

        document.addEventListener("click", function (e) {
        if (widget && panel && !widget.contains(e.target)) {
        panel.classList.add("cookimate-chat-hidden");
        }
        });

        // Keep clicks inside the panel from bubbling out to the close-on-outside handler.
        if (panel) {
        panel.addEventListener("click", function (e) { e.stopPropagation(); });
        }

        // --- messaging ---------------------------------------------------
        function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text == null ? "" : String(text);
        return div.innerHTML;
        }

        function scrollToBottom() {
        if (body) { body.scrollTop = body.scrollHeight; }
        }

        function addUserMessage(text) {
        const el = document.createElement("div");
        el.className = "cookimate-msg cookimate-msg-user";
        el.textContent = text;
        body.appendChild(el);
        scrollToBottom();
        }

        function addBotMessage(text) {
        const el = document.createElement("div");
        el.className = "cookimate-msg cookimate-msg-bot";
        el.textContent = text;
        body.appendChild(el);
        scrollToBottom();
        }

        function addResults(results, limit) {
        if (!results || !results.length) { return; }
        const cap = (typeof limit === "number" && limit > 0) ? limit : 5;
        const wrap = document.createElement("div");
        wrap.className = "cookimate-results";

        results.slice(0, cap).forEach(function (r) {
        const card = document.createElement("a");
        card.className = "cookimate-result-card";
        card.href = "/ViewRecipe?id=" + encodeURIComponent(r.recipe_id);

        const prep = r.prep_time || 0;
        const cook = r.cook_time || 0;
        const total = prep + cook;
        const metaBits = [];
        if (total > 0) { metaBits.push(total + " min"); }
        if (r.difficulty) { metaBits.push(escapeHtml(r.difficulty)); }

        card.innerHTML =
        '<div class="cookimate-result-title">' + escapeHtml(r.title || "Untitled recipe") + '</div>' +
        (metaBits.length ? '<div class="cookimate-result-meta">' + metaBits.join(" · ") + '</div>' : '');

        wrap.appendChild(card);
        });

        body.appendChild(wrap);
        scrollToBottom();
        }

        function showTyping() {
        const el = document.createElement("div");
        el.className = "cookimate-typing";
        el.id = "cookimateTyping";
        el.innerHTML = "<span></span><span></span><span></span>";
        body.appendChild(el);
        scrollToBottom();
        }

        function removeTyping() {
        const el = document.getElementById("cookimateTyping");
        if (el) { el.remove(); }
        }

        function setBusy(isBusy) {
        if (sendBtn) { sendBtn.disabled = isBusy; }
        if (input) { input.disabled = isBusy; }
        }

        async function sendMessage() {
        if (!input) { return; }
        const text = input.value.trim();
        if (!text) { return; }

        addUserMessage(text);
        input.value = "";
        setBusy(true);
        showTyping();

        try {
        const resp = await fetch("/ChatProxy", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: text })
        });

        const data = await resp.json();
        removeTyping();

        if (!resp.ok) {
        addBotMessage(data && data.error ? data.error : "Sorry, something went wrong. Please try again.");
        } else {
        addBotMessage(data.reply || "Here's what I found.");
        addResults(data.results, data.display_limit);
        }
        } catch (err) {
        removeTyping();
        addBotMessage("I couldn't reach the assistant right now. Please try again in a moment.");
        } finally {
        setBusy(false);
        if (input) { input.focus(); }
        }
        }

        if (sendBtn) {
        sendBtn.addEventListener("click", sendMessage);
        }

        if (input) {
        input.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
        e.preventDefault();
        sendMessage();
        }
        });
        }
        });
    </script>

    @*If a page provides a Styles section, render it here. If not, just ignore it.*@
    @RenderSection("Scripts", required: false)

    @*@await RenderSectionAsync("Scripts", required: false)*@
</body>
</html>