@using CookiMateWeb.Includes;
@{
    string cookimateTheme = Context.Request.Cookies["cookimate_theme"] == "dark" ? "dark" : "light";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CookiMateWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CookiMateWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        .cookimate-chat-fab {
        position: fixed;
        right: 24px;
        bottom: 24px;
        width: 64px;
        height: 64px;
        border: none;
        border-radius: 999px;
        background: linear-gradient(135deg, #4e9f3d, #7bc043);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        cursor: pointer;
        box-shadow: 0 16px 32px rgba(78, 159, 61, 0.28);
        z-index: 9999;
        transition: transform 0.22s ease, box-shadow 0.22s ease, opacity 0.22s ease;
        }

        .cookimate-chat-fab:hover {
        transform: translateY(-2px) scale(1.03);
        box-shadow: 0 20px 36px rgba(78, 159, 61, 0.34);
        }

        .cookimate-chat-panel {
        position: fixed;
        right: 24px;
        bottom: 100px;
        width: 340px;
        max-width: calc(100vw - 28px);
        background: #ffffff;
        border: 1px solid #e5efe0;
        border-radius: 22px;
        box-shadow: 0 20px 44px rgba(0, 0, 0, 0.14);
        overflow: hidden;
        z-index: 9999;
        }

        .cookimate-chat-hidden {
        display: none;
        }

        .cookimate-chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px;
        background: linear-gradient(135deg, #4e9f3d, #7bc043);
        color: #ffffff;
        }

        .cookimate-chat-title {
        font-size: 15px;
        font-weight: 800;
        }

        .cookimate-chat-close {
        border: none;
        background: transparent;
        color: #ffffff;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        }

        .cookimate-chat-body {
        padding: 18px;
        background: #f9fbf7;
        }

        .cookimate-chat-bubble {
        background: #ffffff;
        border: 1px solid #e5efe0;
        border-radius: 16px 16px 16px 6px;
        padding: 14px 15px;
        color: #374151;
        font-size: 14px;
        line-height: 1.7;
        }

        .cookimate-chat-footer {
        padding: 12px 18px 16px;
        background: #ffffff;
        border-top: 1px solid #eef2e8;
        }

        .cookimate-chat-tag {
        display: inline-block;
        font-size: 12px;
        font-weight: 700;
        color: #92400e;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 999px;
        padding: 6px 10px;
        }

        /* --- interactive chat --- */
        .cookimate-chat-body {
        max-height: 380px;
        min-height: 160px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        }

        .cookimate-msg {
        max-width: 85%;
        font-size: 14px;
        line-height: 1.6;
        padding: 11px 14px;
        border-radius: 16px;
        word-wrap: break-word;
        }

        .cookimate-msg-user {
        align-self: flex-end;
        background: linear-gradient(135deg, #4e9f3d, #7bc043);
        color: #ffffff;
        border-radius: 16px 16px 6px 16px;
        }

        .cookimate-msg-bot {
        align-self: flex-start;
        background: #ffffff;
        border: 1px solid #e5efe0;
        color: #374151;
        border-radius: 16px 16px 16px 6px;
        }

        .cookimate-results {
        align-self: flex-start;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 8px;
        }

        .cookimate-result-card {
        display: block;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #e5efe0;
        border-radius: 12px;
        padding: 10px 12px;
        transition: border-color 0.15s ease, transform 0.15s ease;
        }

        .cookimate-result-card:hover {
        border-color: #7bc043;
        transform: translateX(2px);
        }

        .cookimate-result-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #2f5d2f;
        margin-bottom: 2px;
        }

        .cookimate-result-meta {
        font-size: 12px;
        color: #6b7280;
        }

        .cookimate-typing {
        align-self: flex-start;
        display: inline-flex;
        gap: 4px;
        padding: 12px 14px;
        background: #ffffff;
        border: 1px solid #e5efe0;
        border-radius: 16px 16px 16px 6px;
        }

        .cookimate-typing span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #9ca3af;
        animation: cookimate-bounce 1.2s infinite ease-in-out;
        }

        .cookimate-typing span:nth-child(2) {
        animation-delay: 0.15s;
        }

        .cookimate-typing span:nth-child(3) {
        animation-delay: 0.3s;
        }

        @@keyframes cookimate-bounce {
        0%, 60%, 100% {
        transform: translateY(0);
        opacity: 0.4;
        }

        30% {
        transform: translateY(-5px);
        opacity: 1;
        }
        }

        .cookimate-chat-inputrow {
        display: flex;
        gap: 8px;
        align-items: center;
        }

        .cookimate-chat-input {
        flex: 1;
        border: 1px solid #d1d5db;
        border-radius: 999px;
        padding: 10px 14px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.15s ease;
        }

        .cookimate-chat-input:focus {
        border-color: #7bc043;
        }

        .cookimate-chat-send {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 50%;
        background: linear-gradient(135deg, #4e9f3d, #7bc043);
        color: #ffffff;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.15s ease;
        }

        .cookimate-chat-send:disabled {
        opacity: 0.5;
        cursor: default;
        }

        @@media (max-width: 640px) {
        .cookimate-chat-fab {
        right: 16px;
        bottom: 16px;
        width: 58px;
        height: 58px;
        font-size: 22px;
        }

        .cookimate-chat-panel {
        right: 16px;
        bottom: 84px;
        width: calc(100vw - 32px);
        }
        }

        /* --- sitewide dark theme (base-level; does not restyle every page's
        hardcoded colors, e.g. individual recipe card gradients) --- */
        body[data-theme="dark"] {
        background-color: #0f172a;
        color: #e5e7eb;
        }

        body[data-theme="dark"] .bg-white,
        body[data-theme="dark"] header,
        body[data-theme="dark"] .hero-card,
        body[data-theme="dark"] .form-card {
        background-color: #1e293b !important;
        color: #e5e7eb !important;
        border-color: #334155 !important;
        }

        body[data-theme="dark"] .text-gray-700,
        body[data-theme="dark"] .text-gray-800,
        body[data-theme="dark"] p,
        body[data-theme="dark"] label {
        color: #cbd5e1 !important;
        }

        body[data-theme="dark"] .field-control,
        body[data-theme="dark"] input,
        body[data-theme="dark"] select,
        body[data-theme="dark"] textarea {
        background-color: #0f172a !important;
        color: #e5e7eb !important;
        border-color: #334155 !important;
        }

        body[data-theme="dark"] .hero-title {
        color: #86efac !important;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
