@page
@model CookiMateWeb.Pages.MealPlanModel
@{
    ViewData["Title"] = "Meal Plan";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .mealplan-page {
            background: radial-gradient(circle at top left, rgba(123, 192, 67, 0.10), transparent 28%), radial-gradient(circle at top right, rgba(78, 159, 61, 0.08), transparent 24%), linear-gradient(to bottom, #f8fcf6, #ffffff 260px);
            min-height: 100vh;
        }

        .mealplan-container {
            max-width: 1240px;
            margin: 0 auto;
            padding: 34px 20px 70px;
        }

        .hero-card {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #ffffff, #f6fbf2);
            border: 1px solid #eef2e8;
            border-radius: 28px;
            padding: 34px 30px;
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.06);
            margin-bottom: 26px;
        }

        .hero-card::before {
            content: "";
            position: absolute;
            top: -40px;
            right: -30px;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(123, 192, 67, 0.18), transparent 70%);
            pointer-events: none;
        }

        .hero-title {
            font-size: 34px;
            font-weight: 800;
            color: #2f5d2f;
            margin-bottom: 10px;
            line-height: 1.2;
        }

        .hero-subtitle {
            color: #6b7280;
            font-size: 15px;
            line-height: 1.8;
            max-width: 780px;
            margin-bottom: 18px;
        }

        .hero-stats {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: #ffffff;
            border: 1px solid #e7efdf;
            border-radius: 999px;
            padding: 10px 16px;
            box-shadow: 0 8px 18px rgba(78, 159, 61, 0.08);
            font-size: 14px;
            color: #4b5563;
            font-weight: 600;
        }

        .hero-stats-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 30px;
            height: 30px;
            border-radius: 999px;
            background: linear-gradient(135deg, #4e9f3d, #7bc043);
            color: white;
            font-size: 13px;
            font-weight: 700;
            padding: 0 10px;
        }

        .date-pills-card {
            background: #ffffff;
            border-radius: 24px;
            border: 1px solid #eef2e8;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
            padding: 18px 18px 12px;
            margin-bottom: 26px;
        }

        .date-pills-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .date-pills-title {
            font-size: 18px;
            font-weight: 700;
            color: #2f5d2f;
        }

        .date-pills-subtitle {
            font-size: 14px;
            color: #6b7280;
        }

        .date-pills-scroll {
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .date-pills-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .date-pills-scroll::-webkit-scrollbar-thumb {
            background: #d8e7cf;
            border-radius: 999px;
        }

        .date-pills-row {
            display: flex;
            gap: 12px;
            min-width: max-content;
        }

        .date-pill {
            text-decoration: none;
            min-width: 78px;
            background: #f9fcf7;
            border: 1px solid #e5efe0;
            border-radius: 999px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: 0.2s ease;
            color: #4b5563;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.03);
        }

        .date-pill:hover {
            transform: translateY(-2px);
            border-color: #cfe3c2;
            background: #f6fbf2;
            text-decoration: none;
            color: #2f5d2f;
        }

        .date-pill.active {
            background: linear-gradient(135deg, #4e9f3d, #7bc043);
            color: #ffffff;
            border-color: transparent;
            box-shadow: 0 12px 24px rgba(78, 159, 61, 0.24);
        }

        .date-pill.today:not(.active) {
            border-color: #b9ddaa;
            background: #f3faee;
        }

        .date-pill-day {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.2px;
        }

        .date-pill-number {
            font-size: 22px;
            font-weight: 800;
            line-height: 1.15;
            margin: 2px 0;
        }

        .date-pill-month {
            font-size: 12px;
            font-weight: 700;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 22px;
        }

        .topbar-left h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #2f5d2f;
        }

        .topbar-left p {
            margin: 5px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .page-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            padding: 10px 16px;
            background: #ffffff;
            border: 1px solid #e5efe0;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.04);
            font-size: 14px;
            font-weight: 600;
            color: #4b5563;
        }

        .meal-section {
            margin-bottom: 28px;
        }

        .meal-section-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .meal-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 42px;
            height: 42px;
            border-radius: 14px;
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            color: #2f5d2f;
            font-size: 18px;
            box-shadow: 0 8px 18px rgba(78, 159, 61, 0.10);
        }

        .meal-section-title {
            font-size: 22px;
            font-weight: 750;
            color: #2f5d2f;
            margin: 0;
            text-transform: capitalize;
        }

        .meal-section-subtitle {
            margin: 4px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

        .recipes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 24px;
        }

        .recipe-card-link {
            text-decoration: none;
            color: inherit;
            display: block;
            height: 100%;
        }

        .recipe-card {
            background: #ffffff;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid #eef2e8;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
            transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .recipe-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 22px 42px rgba(0, 0, 0, 0.10);
            border-color: #dcebd1;
        }

        .recipe-image-wrap {
            position: relative;
            width: 100%;
            height: 230px;
            background: linear-gradient(135deg, #f7fbf4, #eef8e8);
            overflow: hidden;
        }

        .recipe-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.3s ease;
        }

        .recipe-card:hover .recipe-image {
            transform: scale(1.03);
        }

        .difficulty-badge {
            position: absolute;
            top: 14px;
            right: 14px;
            padding: 8px 13px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            text-transform: capitalize;
            backdrop-filter: blur(8px);
            background: rgba(240, 253, 244, 0.94);
            color: #166534;
            border: 1px solid #bbf7d0;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.06);
        }

        .recipe-body {
            padding: 20px 20px 18px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .recipe-title {
            font-size: 20px;
            font-weight: 750;
            color: #2f5d2f;
            margin-bottom: 10px;
            line-height: 1.4;
            word-break: break-word;
        }

        .recipe-description {
            font-size: 14px;
            color: #6b7280;
            line-height: 1.8;
            margin-bottom: 16px;
            min-height: 76px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .recipe-meta-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 16px;
        }

        .meta-pill {
            background: linear-gradient(135deg, #f8fcf6, #f2f9ed);
            border: 1px solid #e7f1df;
            border-radius: 16px;
            padding: 12px 10px;
            text-align: center;
        }

        .meta-label {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.2px;
            color: #6b7280;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .meta-value {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
        }

        .card-footer {
            margin-top: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding-top: 14px;
            border-top: 1px solid #f2f4ef;
        }

        .view-hint {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 700;
            color: #4e9f3d;
        }

        .view-arrow {
            width: 28px;
            height: 28px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eef8e8;
            color: #4e9f3d;
            font-size: 14px;
            transition: transform 0.2s ease;
        }

        .recipe-card:hover .view-arrow {
            transform: translateX(3px);
        }

        .meal-empty-card,
        .empty-state {
            background: #ffffff;
            border-radius: 24px;
            padding: 28px 24px;
            text-align: center;
            border: 1px solid #eef2e8;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
        }

        .meal-empty-card p,
        .empty-state p {
            color: #6b7280;
            font-size: 14px;
            line-height: 1.8;
            margin: 0;
        }

        .empty-state {
            border-radius: 28px;
            padding: 58px 28px;
        }

        .empty-icon {
            width: 82px;
            height: 82px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
            color: #4e9f3d;
            font-size: 30px;
            font-weight: 700;
        }

        .empty-state h3 {
            font-size: 25px;
            font-weight: 700;
            color: #2f5d2f;
            margin-bottom: 8px;
        }

        .browse-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-top: 18px;
            padding: 12px 18px;
            border-radius: 14px;
            background: linear-gradient(135deg, #4e9f3d, #7bc043);
            color: white;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            box-shadow: 0 10px 22px rgba(78, 159, 61, 0.22);
        }

        .browse-link:hover {
            color: white;
            text-decoration: none;
            transform: translateY(-1px);
        }

        .alert-error {
            margin-bottom: 18px;
            padding: 13px 15px;
            border-radius: 14px;
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
            font-size: 14px;
        }

        .remove-meal-btn {
            background: #fff;
            color: #ef4444;
            border: 1px solid #fecaca;
            border-radius: 999px;
            min-width: 120px;
            height: 34px;
            padding: 0 14px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .remove-meal-btn:hover {
            background: #fecaca;
            transform: scale(1.05);
        }

        .toast-success {
            position: fixed;
            top: 92px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            min-width: 260px;
            max-width: 360px;
            padding: 14px 16px;
            border-radius: 16px;
            background: linear-gradient(135deg, #4e9f3d, #7bc043);
            color: #ffffff;
            box-shadow: 0 16px 36px rgba(78, 159, 61, 0.28);
            font-size: 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastSlideIn 0.35s ease;
        }

        .toast-error {
            position: fixed;
            top: 92px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            min-width: 260px;
            max-width: 360px;
            padding: 14px 16px;
            border-radius: 16px;
            background: #ffffff;
            color: #b91c1c;
            border: 1px solid #fecaca;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.10);
            font-size: 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: toastSlideIn 0.35s ease;
        }

        @@keyframes toastSlideIn {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .hero-card {
                padding: 28px 22px;
            }

            .hero-title {
                font-size: 28px;
            }

            .recipe-image-wrap {
                height: 210px;
            }
        }

        @@media (max-width: 640px) {
            .mealplan-container {
                padding: 24px 14px 56px;
            }

            .hero-title {
                font-size: 26px;
            }

            .page-badge {
                width: 100%;
                justify-content: center;
            }

            .recipe-title {
                font-size: 18px;
            }

            .recipe-meta-grid {
                grid-template-columns: 1fr;
            }

            .recipe-description {
                min-height: auto;
            }

            .toast-success,
            .toast-error {
                top: 84px;
                left: 50%;
                transform: translateX(-50%);
                width: calc(100% - 28px);
                max-width: none;
            }
        }
    </style>
}

@{
    var totalMeals = Model.MealGroups.Values.Sum(x => x.Count);

    var mealMeta = new Dictionary<string, (string Icon, string Subtitle)>
    {
        { "breakfast", ("☀️", "Start the day with something satisfying.") },
        { "lunch", ("🥗", "Midday meals to keep your energy up.") },
        { "dinner", ("🍽️", "Hearty dishes to wrap up the day.") },
        { "snack", ("🍎", "Light bites between main meals.") }
    };
}

<div class="mealplan-page">
    <div class="mealplan-container">
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div id="successToast" class="toast-success">
                <span>✅</span>
                <span>@Model.SuccessMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div id="errorToast" class="toast-error">
                <span>⚠</span>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <div class="hero-card">
            <div class="hero-title">Plan Your Meals with Ease</div>
            <div class="hero-subtitle">
                Browse your daily meal schedule in a clean calendar view. Click a date pill to see the meal plan
                for that day, then open any recipe card to view full cooking details and instructions.
            </div>
            <div class="hero-stats">
                <span class="hero-stats-number">@totalMeals</span>
                <span>Meals planned for @Model.SelectedDate.ToString("dd MMM")</span>
            </div>
        </div>

        <div class="date-pills-card">
            <div class="date-pills-header">
                <div>
                    <div class="date-pills-title">30-Day Meal Planner</div>
                    <div class="date-pills-subtitle">Select a day to view its meal plan.</div>
                </div>

                <div class="page-badge">
                    <span>@Model.SelectedDateDisplay</span>
                </div>
            </div>

            <div class="date-pills-scroll">
                <div class="date-pills-row">
                    @foreach (var pill in Model.DatePills)
                    {
                        <a asp-page="/MealPlan"
                           asp-route-date="@pill.DateValue"
                           class="date-pill @(pill.IsSelected ? "active" : "") @(pill.IsToday ? "today" : "")">
                            <span class="date-pill-day">@pill.ShortDay</span>
                            <span class="date-pill-number">@pill.DayNumber</span>
                            <span class="date-pill-month">@pill.ShortMonth</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="topbar">
            <div class="topbar-left">
                <p>Meal schedule for @Model.SelectedDateDisplay.</p>

                @{
                    var emptyMealTypes = new[] { "breakfast", "lunch", "dinner", "snack" }
                        .Where(m => !Model.MealGroups.ContainsKey(m) || !Model.MealGroups[m].Any())
                        .ToList();
                }

                @if (emptyMealTypes.Any() && totalMeals > 0)
                {
                    var emptyList = string.Join(" and ", emptyMealTypes);
                    <p style="margin: 6px 0 0; font-size: 16px; color: #d97706; font-weight: 600;">
                        💡 You haven't planned your @emptyList for @Model.SelectedDateDisplay yet.
                    </p>
                }
            </div>

            <div class="page-badge">
                <span>Total Meals</span>
                <strong>@totalMeals</strong>
            </div>
        </div>

        @if (totalMeals == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📅</div>
                <h3>No meals planned for this day</h3>
                <p>
                    There is no meal plan saved for @Model.SelectedDateDisplay yet. You can browse recipes first,
                    then later connect them to this date in your meal planner flow.
                </p>
                <a href="/Index" class="browse-link">Browse Recipes</a>
            </div>
        }
        else
        {
            @foreach (var mealType in new[] { "breakfast", "lunch", "dinner", "snack" })
            {
                var items = Model.MealGroups.ContainsKey(mealType)
                    ? Model.MealGroups[mealType]
                    : new List<CookiMateWeb.Pages.MealPlanModel.MealRecipeCardViewModel>();

                var icon = mealMeta[mealType].Icon;
                var subtitle = mealMeta[mealType].Subtitle;

                <div class="meal-section">
                    <div class="meal-section-header">
                        <div class="meal-badge">@icon</div>
                        <div>
                            <h3 class="meal-section-title">@mealType</h3>
                            <p class="meal-section-subtitle">@subtitle</p>
                        </div>
                    </div>

                    @if (!items.Any())
                    {
                        <div class="meal-empty-card">
                            <p>No recipe has been added for @mealType yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="recipes-grid">
                            @foreach (var recipe in items)
                            {
                                var imagePath = string.IsNullOrWhiteSpace(recipe.ImageUrl)
                                    ? "/images/recipes/default-food.jpg"
                                    : recipe.ImageUrl;

                                var descriptionText = string.IsNullOrWhiteSpace(recipe.Description)
                                    ? "No description available for this recipe."
                                    : recipe.Description;

                                <a href="/ViewRecipe?id=@recipe.RecipeId&from=mealplan&date=@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                   class="recipe-card-link">
                                    <div class="recipe-card">
                                        <div class="recipe-image-wrap">
                                            <img src="@imagePath" alt="@recipe.Title" class="recipe-image" />
                                            <span class="difficulty-badge">
                                                @(string.IsNullOrWhiteSpace(recipe.Difficulty) ? "Medium" : recipe.Difficulty)
                                            </span>
                                        </div>

                                        <div class="recipe-body">
                                            <div style="display:flex; justify-content:flex-end; margin-bottom:10px;">
                                                <form method="post"
                                                      asp-page-handler="Remove"
                                                      asp-route-mealPlanRecipeId="@recipe.MealPlanRecipeId"
                                                      asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                                      onsubmit="event.stopPropagation();">
                                                    <button type="submit"
                                                            onclick="event.stopPropagation();"
                                                            class="remove-meal-btn">
                                                        Remove 🗑
                                                    </button>
                                                </form>
                                            </div>

                                            <div class="recipe-title">@recipe.Title</div>

                                            <div class="recipe-description">
                                                @descriptionText
                                            </div>

                                            <div class="recipe-meta-grid">
                                                <div class="meta-pill">
                                                    <div class="meta-label">Prep Time</div>
                                                    <div class="meta-value">
                                                        @(recipe.PrepTime.HasValue ? $"{recipe.PrepTime} mins" : "-")
                                                    </div>
                                                </div>

                                                <div class="meta-pill">
                                                    <div class="meta-label">Cook Time</div>
                                                    <div class="meta-value">
                                                        @(recipe.CookTime.HasValue ? $"{recipe.CookTime} mins" : "-")
                                                    </div>
                                                </div>

                                                <div class="meta-pill">
                                                    <div class="meta-label">Servings</div>
                                                    <div class="meta-value">
                                                        @(recipe.Servings.HasValue ? recipe.Servings.ToString() : "-")
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="card-footer">
                                                <div class="view-hint">
                                                    <span>View Recipe</span>
                                                </div>
                                                <span class="view-arrow">→</span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            const successToast = document.getElementById('successToast');
            const errorToast = document.getElementById('errorToast');

            if (successToast) {
                successToast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                successToast.style.opacity = '0';
                successToast.style.transform = 'translateY(-8px)';
                setTimeout(() => successToast.remove(), 400);
            }

            if (errorToast) {
                errorToast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                errorToast.style.opacity = '0';
                errorToast.style.transform = 'translateY(-8px)';
                setTimeout(() => errorToast.remove(), 400);
            }
        }, 2500);
    </script>
}